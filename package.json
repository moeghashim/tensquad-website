{
  "name": "tensquads-website",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@10.29.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite dev",
    "dev:ar": "VITE_SITE_LOCALE=ar CLOUDFLARE_ENV=ar vite dev",
    "build:en": "VITE_SITE_LOCALE=en vite build",
    "build:ar": "VITE_SITE_LOCALE=ar CLOUDFLARE_ENV=ar vite build",
    "build": "pnpm build:en && pnpm typecheck",
    "deploy:en": "pnpm build:en && wrangler deploy",
    "deploy:ar": "pnpm build:ar && wrangler deploy",
    "deploy:all": "pnpm run deploy:en && pnpm run deploy:ar",
    "preview": "pnpm build:en && vite preview",
    "preview:ar": "pnpm build:ar && vite preview",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@openuidev/lang-core": "1.1.1",
    "@openuidev/react-lang": "1.1.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wrangler": "^4.162.0"
  }
}
